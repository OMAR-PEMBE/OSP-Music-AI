# Copy to /opt/osp-music/.env on the VPS and chmod 600.
# Generate DJANGO_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a hex-only password for POSTGRES_PASSWORD so DATABASE_URL needs no URL escaping.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=music.example.co.tz
CSRF_TRUSTED_ORIGINS=https://music.example.co.tz
PUBLIC_BASE_URL=https://music.example.co.tz

POSTGRES_DB=osp_music
POSTGRES_USER=osp_music
POSTGRES_PASSWORD=
DATABASE_URL=postgres://osp_music:<same-hex-password>@db:5432/osp_music
REDIS_URL=redis://redis:6379/0

# Production blocks fake generation and requires the live primary engine.
MUSIC_ENGINE=mureka
MUREKA_API_KEY=
MUREKA_BASE_URL=https://api.mureka.ai
MUREKA_JOB_TIMEOUT_SECONDS=1200
SUNO_API_KEY=
SUNO_BASE_URL=

SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_BASE_URL=https://api.snippe.sh

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=osp-music-songs
R2_BACKUP_BUCKET=osp-music-backups

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SENTRY_DSN=
